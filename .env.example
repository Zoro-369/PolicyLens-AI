# GROQ Keys
GROQ_BASE_URL=
GROQ_MODEL=
GROQ_API_KEY=

# Embedding Model
EMBEDDING_MODEL=

# Azure API keys and endpoints
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_VI_NAME=
AZURE_VI_LOCATION=
AZURE_VI_ACCOUNT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# LangSmith tracing (optional; set LANGSMITH_TRACING=true to enable)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=policy-lens-ai
# Compatibility variables used by the installed LangChain callback manager.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=policy-lens-ai
# --- OPTIONAL TUNING (defaults shown) ---
# RETRIEVAL_K=3
# HTTP_TIMEOUT_S=30
# UPLOAD_TIMEOUT_S=600
# VI_POLL_INITIAL_S=10
# VI_POLL_MAX_INTERVAL_S=60
# VI_MAX_WAIT_S=1800

# --- DEMO MODE (no Azure needed) ---
# DEMO_MODE=true
# Use a sample instead of a YouTube URL, e.g. VIDEO_URL=demo://undisclosed_sponsorship
# Leave GROQ_API_KEY empty to use the keyword-rule mock auditor, or set it to use the real LLM.
# VIDEO_URL=demo://undisclosed_sponsorship